# PanamaCompra Collector - Environment Configuration
# Copy to .env for development/portable use or to $XDG_CONFIG_HOME/panamacompra/env for installed use.

# Network configuration
CHANGEDETECTION_BASE_URL=http://localhost:5000
PC_WEBHOOK_HOST=0.0.0.0
PC_WEBHOOK_PORT=8765

# Collection configuration
PC_WEBHOOK_DETAIL_LIMIT=99
PC_INDEX_LIMIT=0
PC_RUN_MODE=RESTART

# WAHA WhatsApp integration (server container, docker-compose.yml)
WAHA_API_KEY=
WAHA_ENGINE=WEBJS
WAHA_PORT=3000

# WhatsApp notifications (collector side). Sending stays OFF until you:
#   1. Start the WAHA container (docker compose up -d waha) and pair the
#      WhatsApp session by scanning the QR code at http://localhost:3000.
#   2. Set PC_WAHA_ENABLED=1 here or tick "Enable WAHA WhatsApp sending" in the
#      monitor Settings panel (saved to data/config/monitor_settings.env).
#   3. Provide the destination group/channel id (usually ends in @g.us) either
#      as PC_WAHA_CHAT_ID or via the monitor, which saves it to
#      data/config/waha_chat_id.txt.
# PC_WAHA_API_KEY defaults to WAHA_API_KEY above, so a protected server works
# without extra configuration.
# PC_WAHA_ENABLED=1
# PC_WAHA_CHAT_ID=120363000000000000@g.us
# PC_WAHA_BASE_URL=http://127.0.0.1:3000
# PC_WAHA_SESSION=default
# Optional per-purpose destinations (blank = PC_WAHA_CHAT_ID). Index alerts,
# item-detail follow-ups and status-change messages can each go to a
# different group; also editable from either monitor.
# PC_WAHA_CHAT_ID_INDEX=
# PC_WAHA_CHAT_ID_DETAILS=
# PC_WAHA_CHAT_ID_STATUS=
# Two notifier phases: the index alert goes out right after the index scan and
# a follow-up with the downloaded items after the details finish. Set
# PC_NOTIFY_DETAILS=0 to skip the follow-up (items are absorbed silently).
# PC_NOTIFY_DETAILS=1

# Runtime behavior
PC_REQUEST_OPEN_MONITOR=1
PC_SETUP_SKIP_APT=0
PC_SETUP_SKIP_BROWSER=0
# Set 1 to skip starting the changedetection/WAHA Docker stack during setup.
PC_SETUP_SKIP_DOCKER=0

# Advanced path overrides resolved by lib/env.sh / src/common.py
# PC_DATA_DIR=/custom/path/to/data
# PC_RECORDS_DIR=/custom/path/to/records
# PC_LOG_DIR=/custom/path/to/logs
# PC_ARCHIVE_DB_PATH=/custom/path/to/panamacompra_archive.db
# PC_INDEX_CSV_PATH=/custom/path/to/panamacompra_index.csv
# PC_INTEGRATIONS_DIR=/custom/path/for/docker-container-data (default var/integrations)
