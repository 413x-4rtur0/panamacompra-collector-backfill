# Copy to .env (gitignored) and adjust. Used by docker-compose.yml.

# Public URL changedetection.io advertises in its own UI and notification links.
CHANGEDETECTION_BASE_URL=http://localhost:5000

# Host port the webhook listener container publishes (matches .webhook_token path).
PC_WEBHOOK_PORT=8765

# Detail pages processed per triggered run (read by the host runner).
PC_WEBHOOK_DETAIL_LIMIT=99

# Optional WAHA API key. When set, also export PC_WAHA_API_KEY=<same value> for the
# host collector so it can authenticate to WAHA's /api/sendText.
WAHA_API_KEY=

# WAHA WhatsApp engine (WEBJS is the default web.whatsapp.com engine).
WAHA_ENGINE=WEBJS

# NOTE: the webhook path token itself lives in ./.webhook_token (gitignored), NOT
# here. In the changedetection.io UI set the watch notification URL to:
#   json://webhook:8765/panamacompra/<contents-of-.webhook_token>?method=POST
