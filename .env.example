# PanamaCompra Collector - Environment Configuration
# Copy to .env for development/portable use or to $XDG_CONFIG_HOME/panamacompra/env for installed use.

# Network configuration
CHANGEDETECTION_BASE_URL=http://localhost:5000
CHANGEDETECTION_PORT=5000
PC_WEBHOOK_HOST=0.0.0.0
PC_WEBHOOK_PORT=8765

# Collection configuration
PC_WEBHOOK_DETAIL_LIMIT=99
PC_INDEX_LIMIT=0
PC_RUN_MODE=RESTART

# WAHA WhatsApp integration
WAHA_API_KEY=
WAHA_ENGINE=WEBJS
WAHA_PORT=3000

# Runtime behavior
PC_REQUEST_OPEN_MONITOR=1
PC_SETUP_SKIP_APT=0
PC_SETUP_SKIP_BROWSER=0

# Advanced path overrides resolved by lib/env.sh / pc_common.py
# PC_DATA_DIR=/custom/path/to/data
# PC_RECORDS_DIR=/custom/path/to/records
# PC_LOG_DIR=/custom/path/to/logs
# PC_ARCHIVE_DB_PATH=/custom/path/to/panamacompra_archive.db
# PC_INDEX_CSV_PATH=/custom/path/to/panamacompra_index.csv

# Docker Compose project name keeps containers/networks isolated from other stacks.
COMPOSE_PROJECT_NAME=panamacompra-collector
