# PanamaCompra Collector - Environment Configuration
# Copy to .env for development/portable use or to $XDG_CONFIG_HOME/panamacompra/env for installed use.

# GitHub token for git/gh operations (update-local-copy.sh, bin/pcc upload-github).
# Only needed if the host's desktop keyring never auto-unlocks (e.g. Linux Mint
# auto-login), which otherwise makes `gh auth git-credential` block git fetch/pull
# on a hidden keyring password prompt. Generate with: gh auth login, then gh auth token
# GH_TOKEN=

# Network configuration
CHANGEDETECTION_BASE_URL=http://localhost:5000
PC_WEBHOOK_HOST=0.0.0.0
PC_WEBHOOK_PORT=8765

# Collection configuration
PC_WEBHOOK_DETAIL_LIMIT=99
PC_INDEX_LIMIT=0
PC_RUN_MODE=RESTART
# AUTO (webhook) runs import the index from the latest changedetection snapshot
# (the browser-steps report in var/integrations/changedetection/<watch-uuid>/)
# instead of re-crawling it with Firefox; partial snapshots crawl only the
# missing group, and any snapshot problem falls back to the full crawler.
# PC_INDEX_FROM_SNAPSHOT=1
# PC_CHANGEDETECTION_DATASTORE=var/integrations/changedetection
# PC_INDEX_SNAPSHOT_MAX_AGE_SECONDS=3600

# WAHA WhatsApp integration (server container, docker-compose.yml)
# setup.sh / src/50_tools/010-docker-stack.sh generate WAHA_API_KEY when blank and
# write the value to data/config/integration-access.txt for review.
WAHA_API_KEY=
# WEBJS uses Chromium. On a low-resource PC, GOWS is the lightweight no-browser
# alternative, but engine session storage is isolated and the first switch can
# require pairing that engine with a new QR. Keep WEBJS unless deliberately
# migrating and ready to pair: WAHA_ENGINE=GOWS.
WAHA_ENGINE=WEBJS
WAHA_PORT=3000
# WAHA dashboard login (asked when opening http://localhost:3000 to review the
# WhatsApp session after an install/reinstall). Leave the password blank and
# setup / `pcc docker up` generates a RANDOM one, saved here and in
# data/config/integration-access.txt so you can always get in; change it here
# or in the monitor Settings tab — it applies on the next docker stack restart.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=

# WhatsApp notifications (collector side). Sending stays OFF until you:
#   1. Start the WAHA container (docker compose up -d waha) and pair the
#      WhatsApp session by scanning the QR code at http://localhost:3000.
#   2. Set PC_WAHA_ENABLED=1 here or tick "Enable WAHA WhatsApp sending" in the
#      monitor Settings panel (saved to data/config/monitor_settings.env).
#   3. Provide the destination group/channel id (usually ends in @g.us) either
#      as PC_WAHA_CHAT_ID or via the monitor, which saves it to
#      data/config/waha_chat_id.txt.
# PC_WAHA_API_KEY defaults to WAHA_API_KEY above, so a protected server works
# without extra configuration.
# PC_WAHA_ENABLED=1
# PC_WAHA_CHAT_ID=120363000000000000@g.us
# PC_WAHA_BASE_URL=http://127.0.0.1:3000
# PC_WAHA_SESSION=default
# Optional per-purpose destinations (blank = PC_WAHA_CHAT_ID). Index alerts,
# item-detail follow-ups and status-change messages can each go to a
# different group; also editable from either monitor.
# PC_WAHA_CHAT_ID_INDEX=
# PC_WAHA_CHAT_ID_DETAILS=
# PC_WAHA_CHAT_ID_STATUS=
# Two notifier phases: the index alert goes out right after the index scan and
# a follow-up with the downloaded items after the details finish. Set
# PC_NOTIFY_DETAILS=0 to skip the follow-up (items are absorbed silently).
# PC_NOTIFY_DETAILS=1
# Message readability controls:
# Seconds to pause between consecutive WhatsApp sends so a batch stays readable
# on the phone instead of arriving all at once (0 disables pacing).
# PC_WAHA_SEND_DELAY_SECONDS=3
# When one run finds more new records than this, the index alerts collapse into
# compact digest message(s) (20 records per message) instead of one long
# per-record burst; each record still gets its own detail follow-up later.
# Set 0 to always send one message per new record.
# PC_NOTIFY_INDEX_DIGEST_THRESHOLD=10
# Send each record's "Detalles Completos" follow-up right after ITS detail page
# downloads (inside the download step), so follow-ups arrive naturally spaced
# instead of as one batch at the end. Set 0 to keep the batch-at-the-end flow.
# PC_NOTIFY_DETAILS_INLINE=1
# Minimum hours between "Sin nuevas entradas" idle messages, so frequent
# webhook-triggered runs do not repeat it (0 = send on every idle run).
# PC_NOTIFY_IDLE_EVERY_HOURS=6

# Runtime behavior
# Override where setup/docker-stack write the local integration access note.
# PC_INTEGRATION_CREDENTIALS_FILE=data/config/integration-access.txt
PC_REQUEST_OPEN_MONITOR=1
PC_SETUP_SKIP_APT=0
PC_SETUP_SKIP_BROWSER=0
# Set 1 to skip installing Docker and starting the changedetection/WAHA stack during setup.
PC_SETUP_SKIP_DOCKER=0

# Advanced path overrides resolved by lib/env.sh / src/common.py
# PC_DATA_DIR=/custom/path/to/data
# PC_RECORDS_DIR=/custom/path/to/records
# PC_LOG_DIR=/custom/path/to/logs
# PC_ARCHIVE_DB_PATH=/custom/path/to/panamacompra_archive.db
# PC_INDEX_CSV_PATH=/custom/path/to/panamacompra_index.csv
# PC_INTEGRATIONS_DIR=/custom/path/for/docker-container-data (default var/integrations)
