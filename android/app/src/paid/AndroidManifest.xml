<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET / ACCESS_NETWORK_STATE come from src/main/AndroidManifest.xml -->

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Monitor">
        <!-- usesCleartextTraffic: the monitor is a plain-HTTP LAN dev server
             with no TLS. Only connect to a monitor on a trusted network. -->

        <activity
            android:name="com.panamacompra.monitor.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Monitor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.panamacompra.monitor.service.NotificationPollingService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>
</manifest>
