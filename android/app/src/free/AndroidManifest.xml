<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET / ACCESS_NETWORK_STATE come from src/main/AndroidManifest.xml -->

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Monitor">
        <!-- usesCleartextTraffic: the monitor is a plain-HTTP LAN dev server
             with no TLS. Only connect to a monitor on a trusted network. -->

        <!-- Google's published TEST AdMob App ID. MUST be replaced with your
             own AdMob App ID (from your AdMob account, not an ad unit ID)
             before any release build: https://support.google.com/admob/answer/7356431 -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name="com.panamacompra.monitor.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Monitor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.panamacompra.monitor.service.NotificationPollingService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>
</manifest>
