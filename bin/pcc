#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/env.sh
source "$SCRIPT_DIR/../lib/env.sh"
cd "$APP_ROOT"

usage() {
  cat <<'USAGE'
Usage: pcc <command> [args]

Run control:
  start [detail_limit] [mode] [index_limit]  Queue/start the full collector run
  stop                                      Stop collector, monitor, updater, and webhook processes
  status                                    Show queue and process status
  watch                                     Live terminal monitor (no GUI needed)
  db                                        Archive/notification counters (records, backlogs)

Monitors & services:
  monitor                                   Open the monitor UI (native/web)
  webhook start|diag                        Start or diagnose the webhook listener
  docker up|down|restart|status|logs        Manage the changedetection + WAHA container stack

Settings (same files the GUI monitors use):
  get [KEY]                                 Show one or all monitor settings
  set KEY VALUE                             Save a monitor setting (e.g. set PC_WAHA_ENABLED 1)
  chat [default|index|details|status] [ID]  Show or save WhatsApp destination chat id(s)
  keywords [list|set "a, b"|clear]          Show or edit the WhatsApp keyword filter

WhatsApp:
  test-whatsapp [message]                   Send one WAHA test message with the saved settings
  notify NUMERO [NUMERO...] [--force]       Send the WhatsApp notification for specific record(s)

Maintenance:
  migrate [args]                            Run the existing layout migration helper
  setup [args]                              Run repository setup
  uninstall [options]                       Stop services/containers and optionally purge state
  launcher [install|remove|path]            Manage Update + Monitor desktop launcher
  env                                       Print resolved runtime environment
  help                                      Show this help
USAGE
}

PY_BIN="$APP_ROOT/.venv/bin/python"
[[ -x "$PY_BIN" ]] || PY_BIN="python3"
SETTINGS_FILE="$PC_DATA_DIR/config/monitor_settings.env"

# Export the monitor-saved settings so notifier commands behave exactly like
# they do when launched from the GUI monitors.
load_monitor_settings() {
  if [[ -f "$SETTINGS_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$SETTINGS_FILE"
    set +a
  fi
}

chat_file_for() {
  case "$1" in
    default|"") echo "$PC_DATA_DIR/config/waha_chat_id.txt" ;;
    index|details|status) echo "$PC_DATA_DIR/config/waha_chat_id_$1.txt" ;;
    *) echo ""; return 1 ;;
  esac
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift || true
case "$cmd" in
  start|run) exec "$APP_ROOT/src/pipeline/request-run-all.sh" "$@" ;;
  stop) exec "$APP_ROOT/src/pipeline/stop-run-all.sh" "$@" ;;
  status) exec "$APP_ROOT/src/pipeline/queue-status.sh" "$@" ;;
  monitor) exec "$APP_ROOT/src/monitor/open-monitor.sh" "$@" ;;
  webhook)
    sub="${1:-start}"; [[ $# -gt 0 ]] && shift || true
    case "$sub" in
      start) exec "$APP_ROOT/src/webhook/start-listener.sh" "$@" ;;
      diag|diagnostic) exec "$APP_ROOT/src/webhook/diagnose.sh" "$@" ;;
      *) echo "Unknown webhook command: $sub" >&2; exit 2 ;;
    esac ;;
  watch) exec "$APP_ROOT/src/monitor/001c-monitor-terminal.sh" "$@" ;;
  docker|stack) exec "$APP_ROOT/src/tools/docker-stack.sh" "$@" ;;
  db|stats)
    exec "$PY_BIN" - <<'PY'
import sys
sys.path.insert(0, __import__("os").environ["APP_ROOT"] + "/src")
from common import init_db
conn = init_db()
cols = {r[1] for r in conn.execute("PRAGMA table_info(opportunities)").fetchall()}
def count(where=""):
    return conn.execute("SELECT COUNT(*) FROM opportunities" + (f" WHERE {where}" if where else "")).fetchone()[0]
print(f"Total records:                     {count()}")
print(f"Details saved:                     {count('detail_status = %r' % 'saved')}")
print(f"Details pending:                   {count('detail_status != %r' % 'saved')}")
print(f"Details failed:                    {count('detail_status = %r' % 'failed')}")
if "notified_at" in cols:
    print(f"Notified (WhatsApp):               {count('notified_at IS NOT NULL')}")
    print(f"Awaiting WhatsApp index alert:     {count('notified_at IS NULL')}")
if "detail_notified_at" in cols:
    print(f"Awaiting item-details WhatsApp:    {count('detail_status = %r AND notified_at IS NOT NULL AND detail_notified_at IS NULL' % 'saved')}")
PY
    ;;
  get)
    key="${1:-}"
    if [[ -n "$key" ]]; then
      KEY="$key" "$PY_BIN" - <<'PY'
import os, shlex
from pathlib import Path
path = Path(os.environ["PC_DATA_DIR"]) / "config" / "monitor_settings.env"
key = os.environ["KEY"]
data = {}
if path.exists():
    for line in path.read_text(encoding="utf-8").splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            k, v = line.split("=", 1)
            try:
                data[k.strip()] = " ".join(shlex.split(v)) if v.strip() else ""
            except ValueError:
                data[k.strip()] = v.strip()
print(data.get(key, os.environ.get(key, "")))
PY
    else
      [[ -f "$SETTINGS_FILE" ]] && grep -v '^#' "$SETTINGS_FILE" | sed '/^$/d' || echo "No monitor settings saved yet ($SETTINGS_FILE)."
    fi
    ;;
  set)
    key="${1:-}"; value="${2-}"
    [[ "$key" =~ ^[A-Z][A-Z0-9_]*$ && $# -ge 2 ]] || { echo "Usage: pcc set KEY VALUE (e.g. pcc set PC_WAHA_ENABLED 1)" >&2; exit 2; }
    KEY="$key" VALUE="$value" "$PY_BIN" - <<'PY'
import os, shlex
from pathlib import Path
path = Path(os.environ["PC_DATA_DIR"]) / "config" / "monitor_settings.env"
data = {}
if path.exists():
    for line in path.read_text(encoding="utf-8").splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            k, v = line.split("=", 1)
            data[k.strip()] = v
data[os.environ["KEY"]] = shlex.quote(os.environ["VALUE"])
lines = [
    "# PanamaCompra monitor settings (KEY=VALUE).",
    "# Edited from the monitor Settings panel or `pcc set`; same-named",
    "# environment variables override these at startup.",
]
lines += [f"{k}={data[k]}" for k in sorted(data)]
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text("\n".join(lines) + "\n", encoding="utf-8")
print(f"Saved {os.environ['KEY']}={os.environ['VALUE']} to {path}")
PY
    ;;
  chat)
    purpose="${1:-}"
    if [[ -z "$purpose" ]]; then
      for p in default index details status; do
        file="$(chat_file_for "$p")"
        printf '%-8s %s\n' "$p:" "$( [[ -s "$file" ]] && head -n 1 "$file" || echo '(not set)')"
      done
      echo "Set with: pcc chat [default|index|details|status] 12036...@g.us (empty id clears)"
    else
      file="$(chat_file_for "$purpose")" || { echo "Unknown destination: $purpose (use default|index|details|status)" >&2; exit 2; }
      if [[ $# -ge 2 ]]; then
        mkdir -p "$(dirname "$file")"
        printf '%s\n' "${2:-}" > "$file"
        echo "Saved '$purpose' WhatsApp destination to $file"
      else
        [[ -s "$file" ]] && head -n 1 "$file" || echo "(not set)"
      fi
    fi
    ;;
  keywords)
    kw_file="$PC_DATA_DIR/config/waha_keywords.txt"
    sub="${1:-list}"
    case "$sub" in
      list) [[ -s "$kw_file" ]] && cat "$kw_file" || echo "(no keyword filter — every new record is announced)" ;;
      set)
        [[ $# -ge 2 ]] || { echo "Usage: pcc keywords set \"palabra1, palabra2\"" >&2; exit 2; }
        mkdir -p "$(dirname "$kw_file")"
        printf '%s\n' "$2" | tr ',' '\n' | sed 's/^ *//; s/ *$//' | sed '/^$/d' > "$kw_file"
        echo "Saved $(wc -l < "$kw_file") keyword(s) to $kw_file"
        ;;
      clear) rm -f "$kw_file"; echo "Keyword filter cleared (every new record will be announced)." ;;
      *) echo "Usage: pcc keywords [list|set \"a, b\"|clear]" >&2; exit 2 ;;
    esac
    ;;
  test-whatsapp)
    load_monitor_settings
    exec "$PY_BIN" "$APP_ROOT/src/notify/waha_client.py" --event info --status TEST \
      --message "${1:-Prueba de notificación desde la CLI pcc.}"
    ;;
  notify)
    [[ $# -ge 1 ]] || { echo "Usage: pcc notify NUMERO [NUMERO...] [--force]" >&2; exit 2; }
    load_monitor_settings
    args=()
    for arg in "$@"; do
      if [[ "$arg" == "--force" ]]; then args+=("--force"); else args+=("--record" "$arg"); fi
    done
    exec "$PY_BIN" "$APP_ROOT/src/pipeline/notify_new_records.py" "${args[@]}"
    ;;
  migrate) exec "$APP_ROOT/src/tools/migrate-apps-layout.sh" "$@" ;;
  setup|install) exec "$APP_ROOT/setup.sh" "$@" ;;
  uninstall) exec "$APP_ROOT/scripts/uninstall.sh" "$@" ;;
  launcher|desktop|shortcut) exec "$APP_ROOT/scripts/install-desktop-launcher.sh" "$@" ;;
  env) env | sort | sed -n '/^APP_MODE=/p;/^APP_ROOT=/p;/^PC_/p;/^XDG_/p' ;;
  -h|--help|help) usage ;;
  -v|--version|version) echo "panamacompra-collector ${APP_VERSION:-unknown}" ;;
  *) echo "Unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
