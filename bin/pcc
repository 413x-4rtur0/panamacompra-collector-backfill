#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/env.sh
source "$SCRIPT_DIR/../lib/env.sh"
cd "$APP_ROOT"

usage() {
  cat <<'USAGE'
Usage: pcc <command> [args]

Run control:
  start [detail_limit] [mode] [index_limit]  Queue/start the full collector run
  stop                                      Stop collector, monitor, updater, and webhook processes
  status                                    Show queue and process status
  watch                                     Live terminal monitor (no GUI needed)
  db | kpi                                  KPI summary + diagrams (same numbers as the
                                            monitors' KPIs tab: counters, groups, entities,
                                            locations, item keywords, trend)
  calendar [day|week|month|year] [--date D] [--field end|start|downloaded]
                                            Opportunities calendar (deadlines by default)

Monitors & services:
  monitor                                   Open the monitor UI (native/web)
  webhook start|diag                        Start or diagnose the webhook listener
  docker up|down|restart|status|logs        Manage the changedetection + WAHA container stack

Settings (same files the GUI monitors use):
  get [KEY]                                 Show one or all monitor settings
  set KEY VALUE                             Save a monitor setting (e.g. set PC_WAHA_ENABLED 1)
  chat [default|index|details|status] [ID]  Show or save WhatsApp destination chat id(s)
  keywords [global|index|details|status] [list|set "..."|clear|test "text"]
                                            Per-destination filters. Rules: OR between
                                            comma/line-separated rules, AND with '+'
                                            (salud + panama), NOT with '-' (-construccion)

WhatsApp:
  test-whatsapp [message]                   Send one WAHA test message with the saved settings
  notify NUMERO [NUMERO...] [--force]       Send the WhatsApp notification for specific record(s)
  format [list|show|preview|set|reset|placeholders] [index|details|status]
                                            Customize the WhatsApp message formats

Work templates (copied into templates/ inside each record folder):
  templates source [PATH]                   Show or set the template source folder
  templates list                            List source files, marking selected ones
  templates select|unselect FILE...         Choose which templates to use
  templates apply [--numero N] [--overwrite] [--apply]   Copy into record folders (dry-run without --apply)

Maintenance:
  migrate [args]                            Run the existing layout migration helper
  setup [args]                              Run repository setup
  uninstall [options]                       Stop services/containers and optionally purge state
  launcher [install|remove|path]            Manage desktop launchers (monitor, WAHA, changedetection, URLs, Docker)
  env                                       Print resolved runtime environment
  help                                      Show this help
USAGE
}

PY_BIN="$APP_ROOT/.venv/bin/python"
[[ -x "$PY_BIN" ]] || PY_BIN="python3"
SETTINGS_FILE="$PC_DATA_DIR/config/monitor_settings.env"

# Export the monitor-saved settings so notifier commands behave exactly like
# they do when launched from the GUI monitors.
load_monitor_settings() {
  if [[ -f "$SETTINGS_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$SETTINGS_FILE"
    set +a
  fi
}

chat_file_for() {
  case "$1" in
    default|"") echo "$PC_DATA_DIR/config/waha_chat_id.txt" ;;
    index|details|status) echo "$PC_DATA_DIR/config/waha_chat_id_$1.txt" ;;
    *) echo ""; return 1 ;;
  esac
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift || true
case "$cmd" in
  start|run) exec "$APP_ROOT/src/pipeline/110a-request-run.sh" "$@" ;;
  stop) exec "$APP_ROOT/src/pipeline/120a-stop-everything.sh" "$@" ;;
  status) exec "$APP_ROOT/src/pipeline/130a-queue-status.sh" "$@" ;;
  monitor) exec "$APP_ROOT/src/monitor/000-open-monitor.sh" "$@" ;;
  webhook)
    sub="${1:-start}"; [[ $# -gt 0 ]] && shift || true
    case "$sub" in
      start) exec "$APP_ROOT/src/webhook/020-start-listener.sh" "$@" ;;
      diag|diagnostic) exec "$APP_ROOT/src/webhook/040-diagnose-webhook.sh" "$@" ;;
      *) echo "Unknown webhook command: $sub" >&2; exit 2 ;;
    esac ;;
  watch) exec "$APP_ROOT/src/monitor/001c-monitor-terminal.sh" "$@" ;;
  docker|stack) exec "$APP_ROOT/src/tools/010-docker-stack.sh" "$@" ;;
  db|stats|kpi|kpis)
    exec "$PY_BIN" - <<'PY'
import json
import re
import sys
from collections import Counter
from pathlib import Path
sys.path.insert(0, __import__("os").environ["APP_ROOT"] + "/src")
from common import init_db
conn = init_db()
cols = {r[1] for r in conn.execute("PRAGMA table_info(opportunities)").fetchall()}
def count(where=""):
    return conn.execute("SELECT COUNT(*) FROM opportunities" + (f" WHERE {where}" if where else "")).fetchone()[0]
total = count()
saved = count("detail_status = 'saved'")
pending = count("detail_status = 'pending'")
failed = count("detail_status = 'failed'")
detail_json = count("COALESCE(detail_json_path, '') <> ''") if "detail_json_path" in cols else 0
closure = round((saved / total) * 100) if total else 0
print("Index + Detail KPI summary")
print(f"Index archive total:               {total}")
print(f"Index records awaiting alert:      {count('notified_at IS NULL') if 'notified_at' in cols else 'n/a'}")
print(f"Details saved:                     {saved}")
print(f"Details pending:                   {pending}")
print(f"Details failed:                    {failed}")
print(f"Detail JSON coverage:              {detail_json}/{total} ({closure}% saved)")
item_total = 0
item_records = 0
item_terms = Counter()
item_locations = Counter()
max_item_record = ("-", 0)
if "detail_json_path" in cols:
    for numero, detail_path in conn.execute("SELECT numero, detail_json_path FROM opportunities WHERE COALESCE(detail_json_path, '') <> '' ORDER BY COALESCE(detail_saved_at, first_seen, '') DESC LIMIT 300"):
        try:
            path = Path(detail_path)
            data = json.loads(path.read_text(encoding="utf-8"))
            summary = data.get("summary") if isinstance(data.get("summary"), dict) else {}
            for key in ("Lugar", "lugar", "Provincia", "provincia", "Unidad de compra", "Dependencia"):
                place = str(summary.get(key) or "").strip()
                if place:
                    item_locations[place[:60]] += 1
                    break
            items = data.get("items")
            if not isinstance(items, list):
                split = data.get("_split") if isinstance(data.get("_split"), dict) else {}
                descriptor = split.get("items") if isinstance(split.get("items"), dict) else {}
                rel = descriptor.get("file")
                items = json.loads((path.parent / rel).read_text(encoding="utf-8")) if rel else []
            items = [item for item in items if isinstance(item, dict)]
        except Exception:
            items = []
        if items:
            item_records += 1
        item_total += len(items)
        if len(items) > max_item_record[1]:
            max_item_record = (str(numero or "-"), len(items))
        for item in items:
            text = " ".join(str(item.get(k, "")) for k in ("descripcion", "description", "nombre", "name", "codigo", "code"))
            for word in re.findall(r"[A-Za-zÁÉÍÓÚÜÑáéíóúüñ0-9]{4,}", text.lower()):
                if not word.isdigit():
                    item_terms[word] += 1
    avg_items = round(item_total / item_records, 1) if item_records else 0
    print(f"Item lines parsed (latest 300):     {item_total} across {item_records} records; avg={avg_items}")
    print(f"Largest item record:               {max_item_record[0]} ({max_item_record[1]} items)")
    if item_terms:
        print("Top item keywords:                 " + " · ".join(f"{k}={v}" for k, v in item_terms.most_common(8)))
if "notified_at" in cols:
    print(f"WAHA index alerts sent:            {count('notified_at IS NOT NULL')}")
if "detail_notified_at" in cols:
    detail_backlog = count("detail_status = 'saved' AND notified_at IS NOT NULL AND detail_notified_at IS NULL")
    print(f"WAHA detail follow-up backlog:     {detail_backlog}")
try:
    rows = conn.execute("SELECT detail_status, COUNT(*) AS c FROM opportunities GROUP BY detail_status ORDER BY c DESC").fetchall()
    print("Detail status mix:                 " + " · ".join(f"{r[0] or '(blank)'}={r[1]}" for r in rows))
    trend = conn.execute("SELECT substr(COALESCE(NULLIF(first_seen, ''), detail_saved_at, finish_date_guess, 'unknown'), 1, 7) AS period, COUNT(*) AS c FROM opportunities GROUP BY period ORDER BY period DESC LIMIT 6").fetchall()
    print("Recent index/detail trend:         " + " · ".join(f"{r[0] or 'unknown'}={r[1]}" for r in trend))
except Exception:
    pass

# KPI diagrams (same data as the monitors' KPIs tab): terminal bar charts about
# groups, contracting entities and the locations parsed from the detail pages.
def bar_rows(title, rows, width=28):
    rows = [(str(label), int(count)) for label, count in rows if str(label).strip()][:8]
    if not rows:
        return
    print()
    print(title)
    top = max(count for _, count in rows) or 1
    for label, count in rows:
        bar = "█" * max(1, round(width * count / top))
        print(f"  {label[:36]:<36} {bar} {count}")

try:
    bar_rows("Index groups:", conn.execute(
        "SELECT COALESCE(NULLIF(grupo, ''), '(sin grupo)') AS g, COUNT(*) FROM opportunities GROUP BY g ORDER BY COUNT(*) DESC LIMIT 8").fetchall())
    if "entidad" in cols:
        bar_rows("Top contracting entities:", conn.execute(
            "SELECT COALESCE(NULLIF(entidad, ''), '(sin entidad)') AS e, COUNT(*) FROM opportunities GROUP BY e ORDER BY COUNT(*) DESC LIMIT 8").fetchall())
    bar_rows("Locations / buying units (from details):", item_locations.most_common(8))
except Exception:
    pass
PY
    ;;
  get)
    key="${1:-}"
    if [[ -n "$key" ]]; then
      KEY="$key" "$PY_BIN" - <<'PY'
import os, shlex
from pathlib import Path
path = Path(os.environ["PC_DATA_DIR"]) / "config" / "monitor_settings.env"
key = os.environ["KEY"]
data = {}
if path.exists():
    for line in path.read_text(encoding="utf-8").splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            k, v = line.split("=", 1)
            try:
                data[k.strip()] = " ".join(shlex.split(v)) if v.strip() else ""
            except ValueError:
                data[k.strip()] = v.strip()
print(data.get(key, os.environ.get(key, "")))
PY
    else
      [[ -f "$SETTINGS_FILE" ]] && grep -v '^#' "$SETTINGS_FILE" | sed '/^$/d' || echo "No monitor settings saved yet ($SETTINGS_FILE)."
    fi
    ;;
  set)
    key="${1:-}"; value="${2-}"
    [[ "$key" =~ ^[A-Z][A-Z0-9_]*$ && $# -ge 2 ]] || { echo "Usage: pcc set KEY VALUE (e.g. pcc set PC_WAHA_ENABLED 1)" >&2; exit 2; }
    KEY="$key" VALUE="$value" "$PY_BIN" - <<'PY'
import os, shlex
from pathlib import Path
path = Path(os.environ["PC_DATA_DIR"]) / "config" / "monitor_settings.env"
data = {}
if path.exists():
    for line in path.read_text(encoding="utf-8").splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            k, v = line.split("=", 1)
            data[k.strip()] = v
data[os.environ["KEY"]] = shlex.quote(os.environ["VALUE"])
lines = [
    "# PanamaCompra monitor settings (KEY=VALUE).",
    "# Edited from the monitor Settings panel or `pcc set`; same-named",
    "# environment variables override these at startup.",
]
lines += [f"{k}={data[k]}" for k in sorted(data)]
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text("\n".join(lines) + "\n", encoding="utf-8")
print(f"Saved {os.environ['KEY']}={os.environ['VALUE']} to {path}")
PY
    ;;
  chat)
    purpose="${1:-}"
    if [[ -z "$purpose" ]]; then
      for p in default index details status; do
        file="$(chat_file_for "$p")"
        printf '%-8s %s\n' "$p:" "$( [[ -s "$file" ]] && head -n 1 "$file" || echo '(not set)')"
      done
      echo "Set with: pcc chat [default|index|details|status] 12036...@g.us (empty id clears)"
    else
      file="$(chat_file_for "$purpose")" || { echo "Unknown destination: $purpose (use default|index|details|status)" >&2; exit 2; }
      if [[ $# -ge 2 ]]; then
        mkdir -p "$(dirname "$file")"
        printf '%s\n' "${2:-}" > "$file"
        echo "Saved '$purpose' WhatsApp destination to $file"
      else
        [[ -s "$file" ]] && head -n 1 "$file" || echo "(not set)"
      fi
    fi
    ;;
  keywords)
    kw_purpose="global"
    case "${1:-}" in global|index|details|status) kw_purpose="$1"; shift ;; esac
    if [[ "$kw_purpose" == "global" ]]; then
      kw_file="$PC_DATA_DIR/config/waha_keywords.txt"
    else
      kw_file="$PC_DATA_DIR/config/waha_keywords_$kw_purpose.txt"
    fi
    sub="${1:-list}"
    case "$sub" in
      list)
        echo "# $kw_purpose filter ($kw_file)"
        if [[ -s "$kw_file" ]]; then cat "$kw_file"; else
          echo "(no rules — $( [[ "$kw_purpose" == global ]] && echo 'every record is announced' || echo 'falls back to the global filter'))"
        fi
        echo "# Rules: OR between lines/commas · AND with '+' (salud + panama) · NOT with '-' (-construccion)"
        ;;
      set)
        [[ $# -ge 2 ]] || { echo "Usage: pcc keywords [$kw_purpose] set \"salud + panama, medicinas, -construccion\"" >&2; exit 2; }
        mkdir -p "$(dirname "$kw_file")"
        printf '%s\n' "$2" | tr ',' '\n' | sed 's/^ *//; s/ *$//' | sed '/^$/d' > "$kw_file"
        echo "Saved $(wc -l < "$kw_file") rule(s) to $kw_file"
        ;;
      clear) rm -f "$kw_file"; echo "$kw_purpose filter cleared." ;;
      test)
        [[ $# -ge 2 ]] || { echo "Usage: pcc keywords [$kw_purpose] test \"texto de la oportunidad\"" >&2; exit 2; }
        KW_PURPOSE="$kw_purpose" KW_TEXT="$2" "$PY_BIN" - <<'PYEOF'
import importlib.util, os
spec = importlib.util.spec_from_file_location(
    "notify_new_records", os.environ["APP_ROOT"] + "/src/pipeline/020-notify-whatsapp.py")
nnr = importlib.util.module_from_spec(spec)
spec.loader.exec_module(nnr)
purpose = os.environ["KW_PURPOSE"]
purpose = "" if purpose == "global" else purpose
includes, excludes = nnr.load_filter_rules(purpose)
result = nnr.evaluate_filter(os.environ["KW_TEXT"], includes, excludes)
print(f"rules: {len(includes)} include, {len(excludes)} exclude")
print(f"WOULD NOTIFY — Coincidencia: {result}" if result else "WOULD NOT NOTIFY (excluded or no include rule matched)")
PYEOF
        ;;
      *) echo "Usage: pcc keywords [global|index|details|status] [list|set \"...\"|clear|test \"...\"]" >&2; exit 2 ;;
    esac
    ;;
  test-whatsapp)
    load_monitor_settings
    exec "$PY_BIN" "$APP_ROOT/src/notify/010-waha-client.py" --event info --status TEST \
      --message "${1:-Prueba de notificación desde la CLI pcc.}"
    ;;
  notify)
    [[ $# -ge 1 ]] || { echo "Usage: pcc notify NUMERO [NUMERO...] [--force]" >&2; exit 2; }
    load_monitor_settings
    args=()
    for arg in "$@"; do
      if [[ "$arg" == "--force" ]]; then args+=("--force"); else args+=("--record" "$arg"); fi
    done
    exec "$PY_BIN" "$APP_ROOT/src/pipeline/020-notify-whatsapp.py" "${args[@]}"
    ;;
  templates|tpl) exec "$PY_BIN" "$APP_ROOT/src/tools/020-record-templates.py" "$@" ;;
  calendar|cal) exec "$PY_BIN" "$APP_ROOT/src/tools/030-opportunity-calendar.py" "$@" ;;
  format|formats) exec "$PY_BIN" "$APP_ROOT/src/tools/040-message-formats.py" "$@" ;;
  migrate) exec "$APP_ROOT/src/tools/100-migrate-apps-layout.sh" "$@" ;;
  setup|install) exec "$APP_ROOT/setup.sh" "$@" ;;
  uninstall) exec "$APP_ROOT/scripts/uninstall.sh" "$@" ;;
  launcher|desktop|shortcut) exec "$APP_ROOT/scripts/install-desktop-launcher.sh" "$@" ;;
  env) env | sort | sed -n '/^APP_MODE=/p;/^APP_ROOT=/p;/^PC_/p;/^XDG_/p' ;;
  -h|--help|help) usage ;;
  -v|--version|version) echo "panamacompra-collector ${APP_VERSION:-unknown}" ;;
  *) echo "Unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
