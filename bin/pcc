#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/env.sh
source "$SCRIPT_DIR/../lib/env.sh"
cd "$APP_ROOT"

usage() {
  cat <<'USAGE'
Usage: pcc <command> [args]

Run control:
  start [detail_limit] [mode] [index_limit]  Queue/start the full collector run
  stop                                      Stop collector, monitor, updater, and webhook processes
  start-all                                 Counterpart to stop: bring Docker integrations + webhook listener back up, open monitor
  status                                    Show queue and process status
  watch                                     Live terminal monitor (no GUI needed)
  db | kpi [--days N] [--grupo X] [--entidad Y] [--json|--csv]
                                            KPI summary + diagrams from the shared engine
                                            (src/40_monitor/monitor_common.py) — the exact
                                            numbers the monitors' KPIs tab shows, sliceable
                                            with the same filters; --json/--csv for scripts
  calendar [day|week|month|year] [--date D] [--field end|start|downloaded]
                                            Opportunities calendar (deadlines by default)

Monitors & services:
  monitor                                   Open the monitor UI (native/web)
  timer [cli|tk|once|json]                  Next-run countdown: cli = in this terminal
                                            (auto-takes-over the terminal monitor when it
                                            closes), tk = separate floating window
  open monitor|changedetection|waha|URL     Open a dashboard in a chromeless app
                                            window — no Firefox, no browser header
                                            (chromium --app when available; set
                                            PC_WEB_APP_BROWSER / PC_WEB_APP_MODE)
  webhook start|diag|info                   Start/diagnose the webhook listener, or show
                                            the trigger token + json:// / host / local URLs
                                            generated by setup
  changedetection-script [--copy|--path]    Print/copy the Browser Steps Execute JS
                                            script for all Programadas + Abiertas pages
  changedetection-check                     Validate the latest changedetection snapshot
  docker up|down|restart|status|logs|timer-sync
                                            Manage the changedetection + WAHA stack;
                                            timer-sync refreshes countdown API/schedule data
  docker-manager [list|audit|start|stop|    Review/manage ALL Docker containers on this host,
    restart|disable|enable|rm|logs|prune|     not just this repo's — flags orphaned/duplicate/
    menu] [name]                              stale ones left by other projects; no args = list

Settings (same files the GUI monitors use):
  get [KEY]                                 Show one or all monitor settings
  set KEY VALUE                             Save a monitor setting (e.g. set PC_WAHA_ENABLED 1)
  chat [default|index|details|status|open_now|system|summary] [ID]
                                            Show or save WhatsApp destination chat id(s)
  keywords [global|index|details|status|open_now] [list|set "..."|clear|test "text"]
                                            Per-destination filters. Rules: OR between
                                            comma/line-separated rules, AND with '+'
                                            (salud + panama), NOT with '-' (-construccion)
  notify-mode [grouped|individual] [MAX]    Show/set index alert batching

WhatsApp:
  clients|waha search [QUERY] [--kind KIND] [--limit N] [--refresh|--json]
                                            Search WAHA contacts, groups, communities,
                                            channels and chats. Multi-word/partial names
                                            and chat IDs are supported; results are cached.
  test-whatsapp [message]                   Send one WAHA test message with the saved settings
  health [--chat-id ID] [--purpose P]       Run system health review; WAHA completion
                                            message uses system/default/index/details/status/open_now/summary
  full-report [--stdout] [--no-logs]        Generate a full diagnostic Markdown report
  upload-github [args]                       Commit local changes and push them to GitHub
  notify NUMERO [NUMERO...] [--force]       Send the WhatsApp notification for specific record(s)
  format [list|show|preview|set|reset|placeholders] [index|details|status|system|summary]
                                            Customize the WhatsApp message formats

Work templates (copied into templates/ inside each record folder):
  templates source [PATH]                   Show or set the template source folder
  templates list                            List source files, marking selected ones
  templates select|unselect FILE...         Choose which templates to use
  templates apply [--numero N] [--overwrite] [--apply]   Copy into record folders (dry-run without --apply)

Maintenance:
  upload [args]                             Alias for upload-github
  migrate [args]                            Run the existing layout migration helper
  setup [args]                              Run repository setup
  uninstall [options]                       Stop services/containers and optionally purge state
  launcher [install|remove|path]            Manage desktop launchers (monitor, WAHA, changedetection, URLs, Docker)
  env                                       Print resolved runtime environment
  help                                      Show this help
USAGE
}

PY_BIN="$APP_ROOT/.venv/bin/python"
[[ -x "$PY_BIN" ]] || PY_BIN="python3"
SETTINGS_FILE="$PC_DATA_DIR/config/monitor_settings.env"

# Export the monitor-saved settings so notifier commands behave exactly like
# they do when launched from the GUI monitors.
load_monitor_settings() {
  if [[ -f "$SETTINGS_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$SETTINGS_FILE"
    set +a
  fi
}

chat_file_for() {
  case "$1" in
    default|"") echo "$PC_DATA_DIR/config/waha_chat_id.txt" ;;
    index|details|status|open_now|system|summary) echo "$PC_DATA_DIR/config/waha_chat_id_$1.txt" ;;
    *) echo ""; return 1 ;;
  esac
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift || true
case "$cmd" in
  start|run) exec "$APP_ROOT/src/20_pipeline/110a-request-run.sh" "$@" ;;
  stop) exec "$APP_ROOT/src/20_pipeline/120a-stop-everything.sh" "$@" ;;
  start-all) exec "$APP_ROOT/src/20_pipeline/120c-start-everything.sh" "$@" ;;
  status) exec "$APP_ROOT/src/20_pipeline/130a-queue-status.sh" "$@" ;;
  monitor) exec "$APP_ROOT/src/40_monitor/000-open-monitor.sh" "$@" ;;
  timer)
    load_monitor_settings
    sub="${1:-cli}"; [[ $# -gt 0 ]] && shift || true
    case "$sub" in
      cli) exec "$PY_BIN" "$APP_ROOT/src/40_monitor/002b-next-run-timer-cli.py" "$@" ;;
      tk)
        nohup "$PY_BIN" "$APP_ROOT/src/40_monitor/002-next-run-timer.py" >> "$PC_LOG_DIR/next_run_timer.log" 2>&1 &
        echo "Tk next-run timer started (log: $PC_LOG_DIR/next_run_timer.log)."
        ;;
      once) exec "$PY_BIN" "$APP_ROOT/src/40_monitor/002b-next-run-timer-cli.py" --once "$@" ;;
      json) exec "$PY_BIN" "$APP_ROOT/src/40_monitor/002b-next-run-timer-cli.py" --json "$@" ;;
      *) echo "Usage: pcc timer [cli|tk|once|json] (cli = terminal countdown, tk = floating window)" >&2; exit 2 ;;
    esac
    ;;
  open|app) exec "$APP_ROOT/src/50_tools/130-open-web-app.sh" "$@" ;;
  webhook)
    sub="${1:-start}"; [[ $# -gt 0 ]] && shift || true
    case "$sub" in
      start) exec "$APP_ROOT/src/10_webhook/020-start-listener.sh" "$@" ;;
      diag|diagnostic) exec "$APP_ROOT/src/10_webhook/040-diagnose-webhook.sh" "$@" ;;
      info|access|token)
        # Live view of the trigger access: the token generated automatically by
        # setup (docker stack up writes .webhook_token when missing) plus the
        # exact URLs to paste into changedetection or use for tests.
        load_monitor_settings
        token_file="$APP_ROOT/.webhook_token"
        token=""
        [[ -s "$token_file" ]] && token="$(tr -d '\r\n' < "$token_file")"
        port="${PC_WEBHOOK_PORT:-8765}"
        public_host="${PC_WEBHOOK_PUBLIC_HOST:-host.docker.internal}"
        shown="${token:-YOUR_TOKEN}"
        query='?method=POST&format=text&overflow=truncate&rto=15&cto=10'
        echo "Webhook token: ${token:-(not generated yet — run ./setup.sh or ./src/50_tools/010-docker-stack.sh up)}"
        echo "Token file:    $token_file"
        echo "Listener port: $port"
        echo
        echo "changedetection notification URL (Docker -> host, recommended):"
        echo "  json://${public_host}:${port}/panamacompra/${shown}${query}"
        echo "Compose-only URL (only if changedetection resolves host 'webhook'):"
        echo "  json://webhook:8765/panamacompra/${shown}${query}"
        echo "From a Docker container to a HOST-run listener (plain HTTP test):"
        echo "  http://${public_host}:${port}/panamacompra/${shown}"
        echo "Local test from this machine:"
        echo "  http://127.0.0.1:${port}/panamacompra/${shown}"
        echo
        echo "The token is generated AUTOMATICALLY by setup; both monitors show this"
        echo "same panel live (Integrations tab), so after an update they read the"
        echo "current settings. Full access note (incl. WAHA login/API key):"
        echo "  $PC_DATA_DIR/config/integration-access.txt"
        ;;
      *) echo "Unknown webhook command: $sub (use start|diag|info)" >&2; exit 2 ;;
    esac ;;
  watch) exec "$APP_ROOT/src/40_monitor/001c-monitor-terminal.sh" "$@" ;;
  docker|stack) exec "$APP_ROOT/src/50_tools/010-docker-stack.sh" "$@" ;;
  docker-manager|containers) exec "$APP_ROOT/src/50_tools/011-docker-manager.sh" "$@" ;;

  changedetection-script|cd-script|browser-js)
    script="$APP_ROOT/config/changedetection-browser-steps.js"
    case "${1:-}" in
      --path) echo "$script" ;;
      --copy)
        if command -v wl-copy >/dev/null 2>&1; then wl-copy < "$script"
        elif command -v xclip >/dev/null 2>&1; then xclip -selection clipboard < "$script"
        elif command -v xsel >/dev/null 2>&1; then xsel --clipboard --input < "$script"
        elif command -v pbcopy >/dev/null 2>&1; then pbcopy < "$script"
        else echo "No clipboard helper found (wl-copy, xclip, xsel, pbcopy). Script path: $script" >&2; exit 1
        fi
        echo "Copied changedetection Browser Steps Execute JS to clipboard."
        ;;
      *)
        cat <<EOF
ChangeDetection → Watch → Browser Steps → Execute JS
Paste the full script below.

Keep these watch filters/settings:
  CSS filter: #pc-monitor-output
  Visual Filter: empty / disabled
  Remove elements: empty
  Triggers: empty

This script crawls Programadas first, then Abiertas, including all pagination pages.

EOF
        cat "$script"
        ;;
    esac
    ;;
  changedetection-check|cd-check)
    load_monitor_settings
    exec "$PY_BIN" "$APP_ROOT/src/20_pipeline/015-import-index-snapshot.py" --dry-run
    ;;
  db|stats|kpi|kpis)
    # KPI summary + diagrams from the SHARED engine (src/40_monitor/monitor_common.py),
    # the same code both GUI monitors use — so the numbers always match the
    # monitors' KPIs tab. Supports --json/--csv plus the usual filters.
    load_monitor_settings
    exec "$PY_BIN" "$APP_ROOT/src/40_monitor/monitor_common.py" "$@"
    ;;
  get)
    key="${1:-}"
    if [[ -n "$key" ]]; then
      KEY="$key" "$PY_BIN" - <<'PY'
import os, shlex
from pathlib import Path
path = Path(os.environ["PC_DATA_DIR"]) / "config" / "monitor_settings.env"
key = os.environ["KEY"]
data = {}
if path.exists():
    for line in path.read_text(encoding="utf-8").splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            k, v = line.split("=", 1)
            try:
                data[k.strip()] = " ".join(shlex.split(v)) if v.strip() else ""
            except ValueError:
                data[k.strip()] = v.strip()
print(data.get(key, os.environ.get(key, "")))
PY
    else
      [[ -f "$SETTINGS_FILE" ]] && grep -v '^#' "$SETTINGS_FILE" | sed '/^$/d' || echo "No monitor settings saved yet ($SETTINGS_FILE)."
    fi
    ;;
  set)
    key="${1:-}"; value="${2-}"
    [[ "$key" =~ ^[A-Z][A-Z0-9_]*$ && $# -ge 2 ]] || { echo "Usage: pcc set KEY VALUE (e.g. pcc set PC_WAHA_ENABLED 1)" >&2; exit 2; }
    KEY="$key" VALUE="$value" "$PY_BIN" - <<'PY'
import os, shlex
from pathlib import Path
path = Path(os.environ["PC_DATA_DIR"]) / "config" / "monitor_settings.env"
data = {}
if path.exists():
    for line in path.read_text(encoding="utf-8").splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            k, v = line.split("=", 1)
            data[k.strip()] = v
data[os.environ["KEY"]] = shlex.quote(os.environ["VALUE"])
lines = [
    "# PanamaCompra monitor settings (KEY=VALUE).",
    "# Edited from the monitor Settings panel or `pcc set`; same-named",
    "# environment variables override these at startup.",
]
lines += [f"{k}={data[k]}" for k in sorted(data)]
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text("\n".join(lines) + "\n", encoding="utf-8")
print(f"Saved {os.environ['KEY']}={os.environ['VALUE']} to {path}")
PY
    ;;
  notify-mode)
    load_monitor_settings
    mode="${1:-}"
    max_records="${2:-${PC_NOTIFY_INDEX_DIGEST_MAX_RECORDS:-100}}"
    if [[ -z "$mode" ]]; then
      threshold="${PC_NOTIFY_INDEX_DIGEST_THRESHOLD:-1}"
      [[ "$threshold" == "0" ]] && mode="individual" || mode="grouped"
      printf 'Index notification mode: %s\nGroup when new count >: %s\nMax records per grouped message: %s\n' "$mode" "$threshold" "$max_records"
      exit 0
    fi
    case "$mode" in
      grouped|group|digest)
        [[ "$max_records" =~ ^[1-9][0-9]*$ ]] || { echo "MAX must be a positive integer" >&2; exit 2; }
        "$0" set PC_NOTIFY_INDEX_DIGEST_THRESHOLD 1
        "$0" set PC_NOTIFY_INDEX_DIGEST_MAX_RECORDS "$max_records"
        ;;
      individual|separate) "$0" set PC_NOTIFY_INDEX_DIGEST_THRESHOLD 0 ;;
      *) echo "Usage: pcc notify-mode [grouped|individual] [MAX]" >&2; exit 2 ;;
    esac
    ;;
  chat)
    purpose="${1:-}"
    if [[ -z "$purpose" ]]; then
      for p in default index details status open_now system summary; do
        file="$(chat_file_for "$p")"
        printf '%-9s %s\n' "$p:" "$( [[ -s "$file" ]] && head -n 1 "$file" || echo '(not set)')"
      done
      echo "Set with: pcc chat [default|index|details|status|open_now|system|summary] 12036...@g.us (empty id clears)"
      echo "open_now = Open Now Opportunities (Programada→Abierta alerts; blank = index destination, then default)"
    else
      file="$(chat_file_for "$purpose")" || { echo "Unknown destination: $purpose (use default|index|details|status|open_now|system|summary)" >&2; exit 2; }
      if [[ $# -ge 2 ]]; then
        mkdir -p "$(dirname "$file")"
        printf '%s\n' "${2:-}" > "$file"
        echo "Saved '$purpose' WhatsApp destination to $file"
      else
        [[ -s "$file" ]] && head -n 1 "$file" || echo "(not set)"
      fi
    fi
    ;;
  keywords)
    kw_purpose="global"
    case "${1:-}" in global|index|details|status|open_now) kw_purpose="$1"; shift ;; esac
    if [[ "$kw_purpose" == "global" ]]; then
      kw_file="$PC_DATA_DIR/config/waha_keywords.txt"
    else
      kw_file="$PC_DATA_DIR/config/waha_keywords_$kw_purpose.txt"
    fi
    sub="${1:-list}"
    case "$sub" in
      list)
        echo "# $kw_purpose filter ($kw_file)"
        if [[ -s "$kw_file" ]]; then cat "$kw_file"; else
          echo "(no rules — $( [[ "$kw_purpose" == global ]] && echo 'every record is announced' || echo 'falls back to the global filter'))"
        fi
        echo "# Rules: OR between lines/commas · AND with '+' (salud + panama) · NOT with '-' (-construccion)"
        ;;
      set)
        [[ $# -ge 2 ]] || { echo "Usage: pcc keywords [$kw_purpose] set \"salud + panama, medicinas, -construccion\"" >&2; exit 2; }
        mkdir -p "$(dirname "$kw_file")"
        printf '%s\n' "$2" | tr ',' '\n' | sed 's/^ *//; s/ *$//' | sed '/^$/d' > "$kw_file"
        echo "Saved $(wc -l < "$kw_file") rule(s) to $kw_file"
        ;;
      clear) rm -f "$kw_file"; echo "$kw_purpose filter cleared." ;;
      test)
        [[ $# -ge 2 ]] || { echo "Usage: pcc keywords [$kw_purpose] test \"texto de la oportunidad\"" >&2; exit 2; }
        KW_PURPOSE="$kw_purpose" KW_TEXT="$2" "$PY_BIN" - <<'PYEOF'
import importlib.util, os
spec = importlib.util.spec_from_file_location(
    "notify_new_records", os.environ["APP_ROOT"] + "/src/20_pipeline/020-notify-whatsapp.py")
nnr = importlib.util.module_from_spec(spec)
spec.loader.exec_module(nnr)
purpose = os.environ["KW_PURPOSE"]
purpose = "" if purpose == "global" else purpose
includes, excludes = nnr.load_filter_rules(purpose)
result = nnr.evaluate_filter(os.environ["KW_TEXT"], includes, excludes)
print(f"rules: {len(includes)} include, {len(excludes)} exclude")
print(f"WOULD NOTIFY — Coincidencia: {result}" if result else "WOULD NOT NOTIFY (excluded or no include rule matched)")
PYEOF
        ;;
      *) echo "Usage: pcc keywords [global|index|details|status|open_now] [list|set \"...\"|clear|test \"...\"]" >&2; exit 2 ;;
    esac
    ;;
  test-whatsapp)
    load_monitor_settings
    exec "$PY_BIN" "$APP_ROOT/src/30_notify/010-waha-client.py" --event info --status TEST --force-send --purpose system \
      --message "${1:-Prueba de notificación desde la CLI pcc.}"
    ;;
  clients|waha|directory|waha-search|contacts)
    load_monitor_settings
    sub="${1:-search}"
    case "$sub" in
      search|find|list) [[ $# -gt 0 ]] && shift || true ;;
      *) ;; # A bare query: `pcc clients compras publicas`.
    esac
    exec "$PY_BIN" "$APP_ROOT/src/50_tools/170-waha-directory.py" "$@"
    ;;
  health|system-health|review)
    load_monitor_settings
    exec "$APP_ROOT/review-system.sh" "$@"
    ;;
  full-report|diagnostic-report|report)
    load_monitor_settings
    exec "$PY_BIN" "$APP_ROOT/src/50_tools/140-full-report.py" "$@"
    ;;
  upload-github|push-github|upload|publish)
    exec "$APP_ROOT/src/50_tools/150-upload-github.sh" "$@"
    ;;
  notify)
    [[ $# -ge 1 ]] || { echo "Usage: pcc notify NUMERO [NUMERO...] [--force]" >&2; exit 2; }
    load_monitor_settings
    args=()
    for arg in "$@"; do
      if [[ "$arg" == "--force" ]]; then args+=("--force"); else args+=("--record" "$arg"); fi
    done
    exec "$PY_BIN" "$APP_ROOT/src/20_pipeline/020-notify-whatsapp.py" "${args[@]}"
    ;;
  templates|tpl) exec "$PY_BIN" "$APP_ROOT/src/50_tools/020-record-templates.py" "$@" ;;
  calendar|cal) exec "$PY_BIN" "$APP_ROOT/src/50_tools/030-opportunity-calendar.py" "$@" ;;
  format|formats) exec "$PY_BIN" "$APP_ROOT/src/50_tools/040-message-formats.py" "$@" ;;
  migrate) exec "$APP_ROOT/src/50_tools/100-migrate-apps-layout.sh" "$@" ;;
  setup|install) exec "$APP_ROOT/setup.sh" "$@" ;;
  uninstall) exec "$APP_ROOT/scripts/uninstall.sh" "$@" ;;
  launcher|desktop|shortcut) exec "$APP_ROOT/scripts/install-desktop-launcher.sh" "$@" ;;
  env) env | sort | sed -n '/^APP_MODE=/p;/^APP_ROOT=/p;/^PC_/p;/^XDG_/p' ;;
  -h|--help|help) usage ;;
  -v|--version|version) echo "panamacompra-collector ${APP_VERSION:-unknown}" ;;
  *) echo "Unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
