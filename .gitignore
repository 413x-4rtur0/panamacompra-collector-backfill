# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local configuration and secrets
.env
.webhook_token*

# Runtime state
/data/
/records/
/records_test/
/var/data/
/var/log/
/var/records/
/var/records_test/
/var/run/
/var/integrations/
/var/templates/
/integrations/
/integrations

# Logs and databases
*.log
*.db
*.sqlite
*.sqlite3

# codebase-memory MCP index artifact: the MCP server rewrites it continuously
# in the background, so tracking it produces a permanently dirty tree and
# blocks rebases. Local data stays on disk; it is just not versioned.
/.codebase-memory/

# Local MCP/codebase-memory index
.codebase-memory/

# Secrets and local environment
.env.*
!.env.example

# Heavy/generated local files
node_modules/
*.zip
*.tar
*.tar.gz

# Local run outputs / editor backups
/var/backups/
/var/calendar/
nohup.out
*.save
*.bak
*.tmp

# Aider AI coding tool artifacts
.aider*
