# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs and temp files
*.log
*.tmp

# Environment
.env
.env.local

# Editors
.vscode/
.idea/
*.swp

# PanamaCompra runtime data — generated on the host, never committed.
# These MUST stay ignored: the updater's `git clean` and resets rely on it so a
# refresh can never delete the collected archive, database, or virtualenv.
/data/
/records/
/records_test/
.venv/
.venv.broken.*/
.webhook_token
