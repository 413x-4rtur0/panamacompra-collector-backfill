# PanamaCompra Collector default configuration.
# Override with .env, $PC_CONFIG_DIR/env, or exported environment variables.
APP_NAME=panamacompra-collector
APP_VERSION=1.0.0
CHANGEDETECTION_BASE_URL=http://localhost:5000
